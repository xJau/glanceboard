# Copy to .env and fill in. .env is gitignored; never commit real values.

# ─── Calendar ───────────────────────────────────────────────────
# The private iCal URL of the client calendar. Treat it as a secret: anyone
# holding it can read every appointment.
# Alternatively set GB_ICAL_URL_FILE=/run/secrets/ical_url to read it from a file.
GB_ICAL_URL=

# ─── Location and time ──────────────────────────────────────────
GB_TIMEZONE=Europe/Rome
GB_LAT=45.4642
GB_LON=9.1900
GB_TEMP_UNIT=celsius

# ─── Panel ──────────────────────────────────────────────────────
# Paperwhite 4 (10th gen, 6"): 1072x1448.  Paperwhite 5/6 (6.8"): 1236x1648.
GB_WIDTH=1072
GB_HEIGHT=1448
# Share of the canvas height kept free at the bottom for the phase-2
# illustration. 0 fills the page with the agenda.
GB_ART_FRACTION=0.30
GB_MAX_EVENTS=12

# ─── Schedule ───────────────────────────────────────────────────
# Hours (local time) at which the board is regenerated.
GB_SLOTS=5,12,18

# ─── Serving ────────────────────────────────────────────────────
# Required. Generate with: python3 -m glanceboard token
GB_DISPLAY_TOKEN=
# Inside Docker this is set to 0.0.0.0 by the image, because the port is never
# published. Running on the host directly, leave it on loopback.
GB_BIND_HOST=127.0.0.1
GB_PORT=8000

# ─── Paths ──────────────────────────────────────────────────────
# Where the rendered PNG and its state file live. /data inside the container.
GB_OUTPUT_DIR=./data
# GB_FONT_DIR=./assets/fonts
